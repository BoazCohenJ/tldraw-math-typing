{
  "manifest_version": 3,
  "name": "Math Typing for tldraw",
  "short_name": "Math Typing",
  "version": "1.7.1",
  "description": "Type maths on tldraw.com: symbols as you type, real fractions and roots, a calculator, graphs and shapes. Not made by tldraw.",
  "homepage_url": "https://github.com/yotam1001/tldraw-math-typing",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "host_permissions": ["https://tldraw.com/*", "https://*.tldraw.com/*"],
  "action": {
    "default_title": "Math Typing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://tldraw.com/*", "https://*.tldraw.com/*"],
      "js": ["rules.js", "fonts.js", "mathtools.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tldraw.com/*", "https://*.tldraw.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tldraw-math-typing@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
